# ---- Safety ---------------------------------------------------------------
# The app refuses to start unless this is true. There is no live-trading code.
PAPER_ONLY=true
STARTING_BALANCE=250

# Prices need no keys: Binance (BTC + gold), Kraken (EUR/USD, GBP/USD),
# Yahoo (USD/JPY), Dukascopy (backtest history) are all public.

# ---- Anthropic (Claude Haiku 5.5) -----------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# $ per million tokens, used for the cost_log. Check https://claude.com/pricing
AI_PRICE_IN_PER_M=0.10
AI_PRICE_OUT_PER_M=0.50

# ---- Telegram alerts (optional but recommended) ---------------------------
# Create a bot with @BotFather, then message it once and get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard login ------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-something-long

# ---- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DB_PATH=data/trader.db
BACKUP_DIR=backups
# Send the nightly DB backup to Telegram as a file (off-server copy)
BACKUP_TO_TELEGRAM=true
